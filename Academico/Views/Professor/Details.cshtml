@model Academico.Models.Professor

@{
    ViewData["Title"] = "Detalhes do Professor";
}

<h1>Detalhes do Professor</h1>

<hr />

<div>

    <dl class="row">

        <dt class="col-sm-3">
            Nome
        </dt>

        <dd class="col-sm-9">
            @Model.Nome
        </dd>

        <dt class="col-sm-3">
            Data de Nascimento
        </dt>

        <dd class="col-sm-9">
            @Model.DataNascimento.ToString("dd/MM/yyyy")
        </dd>

        <dt class="col-sm-3">
            Titulação
        </dt>

        <dd class="col-sm-9">
            @Model.Titulacao
        </dd>

        <dt class="col-sm-3">
            CEP
        </dt>

        <dd class="col-sm-9">
            @Model.Cep
        </dd>

        <dt class="col-sm-3">
            Endereço
        </dt>

        <dd class="col-sm-9">
            @Model.Endereco
        </dd>

        <dt class="col-sm-3">
            Complemento
        </dt>

        <dd class="col-sm-9">
            @Model.Complemento
        </dd>

        <dt class="col-sm-3">
            Bairro
        </dt>

        <dd class="col-sm-9">
            @Model.Bairro
        </dd>

        <dt class="col-sm-3">
            Município
        </dt>

        <dd class="col-sm-9">
            @Model.Municipio
        </dd>

        <dt class="col-sm-3">
            UF
        </dt>

        <dd class="col-sm-9">
            @Model.Uf
        </dd>

    </dl>

</div>

<div class="mt-3">

    <a asp-action="Edit"
           asp-route-id="@Model.ProfessorID"
           class="btn btn-success">
        Editar
    </a>

    <a asp-action="Index"
           class="btn btn-primary">
        Voltar
    </a>

</div>