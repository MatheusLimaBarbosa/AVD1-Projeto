@model IEnumerable<Academico.Models.Professor>

@{
    ViewData["Title"] = "Professores";
}

<h1>Lista de Professores</h1>

<p>
    <a asp-action="Create" class="btn btn-success">
        Cadastrar Professor
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Nome</th>
            <th>Data de Nascimento</th>
            <th>Titulação</th>
            <th>Município</th>
            <th>UF</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nome</td>

                <td>
                    @item.DataNascimento.ToString("dd/MM/yyyy")
                </td>

                <td>@item.Titulacao</td>

                <td>@item.Municipio</td>

                <td>@item.Uf</td>

                <td>
                    <a asp-action="Edit"
                           asp-route-id="@item.ProfessorID">
                        Editar
                    </a>
                    |

                    <a asp-action="Details"
                           asp-route-id="@item.ProfessorID">
                        Detalhes
                    </a>
                    |
                        
                    <a asp-action="Delete"
                           asp-route-id="@item.ProfessorID">
                        Excluir
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>